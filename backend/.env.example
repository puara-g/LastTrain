# data.go.kr / data.seoul.go.kr 에서 발급받은 인증키를 넣으면 실제 데이터로 동작합니다.
# 비워두면 자동으로 샘플(mock) 데이터로 동작합니다.
SEOUL_API_KEY=

# 아래 두 값은 보통 기본값 그대로 쓰면 되지만, 발급받은 API 문서의 예시 URL과
# 다르면 맞춰서 수정하세요.
SEOUL_API_BASE=http://openapi.seoul.go.kr:8088
SEOUL_API_SERVICE=SearchLastTrainTimeByFRCodeService
# 역명으로 역외부코드(FR_CODE)를 찾을 때 쓰는 API (backend/scripts/lookupStationCode.js 참고)
SEOUL_API_STATION_SEARCH_SERVICE=SearchInfoBySubwayNameService
# 빠른하차 정보 (같은 서울 열린데이터광장 키 사용, 별도 발급 불필요)
SEOUL_API_QUICK_EXIT_SERVICE=getFstExit

PORT=4000
